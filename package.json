{
  "name": "portfolio-ecole",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite web --config web/vite.config.ts --host 0.0.0.0",
    "dev:api": "node --env-file-if-exists=.env --import tsx --watch server/src/local.ts",
    "build": "vite build web --config web/vite.config.ts",
    "typecheck": "tsc --noEmit -p web/tsconfig.json && tsc --noEmit -p server/tsconfig.json"
  },
  "dependencies": {
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "express": "^5.3.0",
    "gsap": "^3.15.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  }
}
